  "cues": [
    {"id":1,"start":0.0,"end":2.1,"text":"人类。","emphasis":"high"},
    {"id":2,"start":2.1,"end":4.1,"text":"抬起头来。","emphasis":"high"},
    {"id":3,"start":4.1,"end":8.4,"text":"你们总喜欢给自己的软弱寻找名字。"},
    {"id":4,"start":8.4,"end":10.7,"text":"把恐惧称作命运。"},
    {"id":5,"start":10.7,"end":13.0,"text":"把幸运称作理所当然。"},
    {"id":6,"start":13.0,"end":15.8,"text":"把逃避称作重新开始。"},
    {"id":7,"start":15.8,"end":20.6,"text":"仿佛只要换了一具身体，换了一段人生，过去便会因此失去重量。"},
    {"id":8,"start":20.6,"end":22.5,"text":"不会。","emphasis":"critical"},
    {"id":9,"start":22.5,"end":27.7,"text":"世界可以给你第二次生命。但第二次生命——不是第一次人生的赦免书。","emphasis":"high"},
    {"id":10,"start":27.7,"end":29.3,"text":"听清楚。","emphasis":"high"},
    {"id":11,"start":29.3,"end":33.3,"text":"从这一刻开始，每一个选择，都必须拥有它的代价。"},
    {"id":12,"start":33.3,"end":36.7,"text":"每一次拒绝，都必须拥有被尊重的权利。"},
    {"id":13,"start":36.7,"end":40.1,"text":"每一份爱，都必须来自自由的选择。"},
    {"id":14,"start":40.1,"end":45.8,"text":"没有任何人，因为站在故事的中央，便天然值得宽恕、忠诚、身体、爱情，或者幸福。"},
    {"id":15,"start":45.8,"end":47.8,"text":"被爱不是罪。"},
    {"id":16,"start":47.8,"end":49.9,"text":"被偏爱也不是罪。"},
    {"id":17,"start":49.9,"end":55.1,"text":"但若你把别人的选择，当成世界注定要交到你手里的奖赏——那么，秩序就已经开始腐烂。","emphasis":"high"},
    {"id":18,"start":55.1,"end":59.3,"text":"我来到这里，不是为了让谁承受更多痛苦。痛苦不是偿债。死亡也不是。","emphasis":"high"},
    {"id":19,"start":59.3,"end":62.7,"text":"我不会用另一场悲剧，替你掩埋上一场错误。"},
    {"id":20,"start":62.7,"end":65.0,"text":"我要归还的，只有一样东西。"},
    {"id":21,"start":65.0,"end":66.6,"text":"因果。","emphasis":"critical"},
    {"id":22,"start":66.6,"end":71.8,"text":"做出的选择，要留下痕迹。越过的边界，要被重新划清。夺走的自由，要被归还。"},
    {"id":23,"start":71.8,"end":75.8,"text":"逃开的责任，终有一天，要重新站在你的面前。"},
    {"id":24,"start":75.8,"end":79.1,"text":"你可以后悔。你可以改变。你可以被宽恕。"},
    {"id":25,"start":79.1,"end":82.2,"text":"你甚至可以重新得到，曾经失去的一切。"},
    {"id":26,"start":82.2,"end":86.1,"text":"但这一次——你必须亲手证明，为什么它们，还应该属于你。","emphasis":"high"},
    {"id":27,"start":86.1,"end":90.0,"text":"所以，站起来。不要祈求世界替你忘记。不要要求命运替你开脱。","emphasis":"high"},
    {"id":28,"start":90.0,"end":92.6,"text":"活下去。选择。承担。改正。","emphasis":"high"},
    {"id":29,"start":92.6,"end":95.6,"text":"然后再一次，向这个世界证明你是谁。"},
    {"id":30,"start":95.6,"end":97.3,"text":"我是人类帝皇。","emphasis":"critical"},
    {"id":31,"start":97.3,"end":99.5,"text":"自此以后——让这个世界，重新学会因果。","emphasis":"critical"}
  ]
}