  "cues": [
    {"id":1,"start":0.0,"end":1.367,"text":"人类。","emphasis":"high"},
    {"id":2,"start":1.367,"end":3.55,"text":"抬起头来。","emphasis":"high"},
    {"id":3,"start":3.55,"end":7.809,"text":"你们总喜欢给自己的软弱寻找名字。"},
    {"id":4,"start":7.809,"end":10.236,"text":"把恐惧称作命运。"},
    {"id":5,"start":10.236,"end":13.261,"text":"把幸运称作理所当然。"},
    {"id":6,"start":13.261,"end":16.167,"text":"把逃避称作重新开始。"},
    {"id":7,"start":16.167,"end":23.087,"text":"仿佛只要换了一具身体，换了一段人生，过去便会因此失去重量。"},
    {"id":8,"start":23.087,"end":24.567,"text":"不会。","emphasis":"critical"},
    {"id":9,"start":24.567,"end":32.385,"text":"世界可以给你第二次生命。但第二次生命——不是第一次人生的赦免书。","emphasis":"high"},
    {"id":10,"start":32.385,"end":34.024,"text":"听清楚。","emphasis":"high"},
    {"id":11,"start":34.024,"end":39.669,"text":"从这一刻开始，每一个选择，都必须拥有它的代价。"},
    {"id":12,"start":39.669,"end":43.914,"text":"每一次拒绝，都必须拥有被尊重的权利。"},
    {"id":13,"start":43.914,"end":47.997,"text":"每一份爱，都必须来自自由的选择。"},
    {"id":14,"start":47.997,"end":55.942,"text":"没有任何人，因为站在故事的中央，便天然值得宽恕、忠诚、身体、爱情，或者幸福。"},
    {"id":15,"start":55.942,"end":58.644,"text":"被爱不是罪。"},
    {"id":16,"start":58.644,"end":60.026,"text":"被偏爱也不是罪。"},
    {"id":17,"start":60.026,"end":69.928,"text":"但若你把别人的选择，当成世界注定要交到你手里的奖赏——那么，秩序就已经开始腐烂。","emphasis":"high"},
    {"id":18,"start":69.928,"end":76.799,"text":"我来到这里，不是为了让谁承受更多痛苦。痛苦不是偿债。死亡也不是。","emphasis":"high"},
    {"id":19,"start":76.799,"end":82.989,"text":"我不会用另一场悲剧，替你掩埋上一场错误。"},
    {"id":20,"start":82.989,"end":86.54,"text":"我要归还的，只有一样东西。"},
    {"id":21,"start":86.54,"end":87.074,"text":"因果。","emphasis":"critical"},
    {"id":22,"start":87.074,"end":97.316,"text":"做出的选择，要留下痕迹。越过的边界，要被重新划清。夺走的自由，要被归还。"},
    {"id":23,"start":97.316,"end":102.425,"text":"逃开的责任，终有一天，要重新站在你的面前。"},
    {"id":24,"start":102.425,"end":104.43,"text":"你可以后悔。你可以改变。你可以被宽恕。"},
    {"id":25,"start":104.43,"end":111.181,"text":"你甚至可以重新得到，曾经失去的一切。"},
    {"id":26,"start":111.181,"end":116.993,"text":"但这一次——你必须亲手证明，为什么它们，还应该属于你。","emphasis":"high"},
    {"id":27,"start":116.993,"end":124.4,"text":"所以，站起来。不要祈求世界替你忘记。不要要求命运替你开脱。","emphasis":"high"},
    {"id":28,"start":124.4,"end":128.209,"text":"活下去。选择。承担。改正。","emphasis":"high"},
    {"id":29,"start":128.209,"end":133.403,"text":"然后再一次，向这个世界证明你是谁。"},
    {"id":30,"start":133.403,"end":135.669,"text":"我是人类帝皇。","emphasis":"critical"},
    {"id":31,"start":135.669,"end":140.042,"text":"自此以后——让这个世界，重新学会因果。","emphasis":"critical"}
  ]
}